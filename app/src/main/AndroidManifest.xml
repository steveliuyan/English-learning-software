<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 本应用第一次申请网络权限（F2-03）。它必须与「出站确认」同时在位：
         权限让请求成为可能，确认框让用户知情。不要顺手加其他网络类权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- F4-02 本地提醒：Android 13+ 运行时请求，拒绝后不重复弹窗（设置页提供系统设置入口）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- F4-04 新设备实时扫码（决策 D2）：仅相机取景解码配对码，不拍摄/不存储任何照片。
         运行时请求由恢复页发起，拒绝后页面给出提示并可再次授权，无自动重弹。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- F3-05 悬浮窗屏幕翻译：SYSTEM_ALERT_WINDOW 用来在其他应用上层画译文（一次授权长期有效，
         由用户在系统设置里手动开启，本应用不主动弹窗索要）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 截屏会话必须挂在 mediaProjection 类型的前台服务上（Android 14+ 强制），常驻通知即停止入口。
         注意：这里**没有**声明任何无障碍服务权限——读屏文字树那条路被决策文档明确否决。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".EnglishLearningApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="English Learning"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.EnglishLearning">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.worksheetfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/worksheet_file_paths" />
        </provider>
        <!-- F3-05：一次会话 = 一次授权。MediaProjection 令牌只在本次会话有效，用户按停止/系统回收即结束；
             截屏帧只在本机内存过一遍（不落盘、不上传），出站只有识别出的文字。 -->
        <service
            android:name=".screentranslation.ScreenTranslationService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".launch.BrandLaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.EnglishLearning.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
