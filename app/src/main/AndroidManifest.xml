<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 本应用第一次申请网络权限（F2-03）。它必须与「出站确认」同时在位：
         权限让请求成为可能，确认框让用户知情。不要顺手加其他网络类权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EnglishLearningApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="English Learning"
        android:supportsRtl="true"
        android:theme="@style/Theme.EnglishLearning">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.worksheetfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/worksheet_file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".launch.BrandLaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.EnglishLearning.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
